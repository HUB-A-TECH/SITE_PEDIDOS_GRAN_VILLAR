// Schema do Sistema de Pedidos Gran Villar.
// Fase 1: User, Local, Vendedor, TokenRevogado.
// Fase 2: Cliente, Produto, ClienteProduto, Pedido, ItemPedido.
// Tabelas de preco: TabelaPreco, TabelaPrecoItem, ClienteVendedor (carteira).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  VENDEDOR
  ADMIN_COMERCIAL
  ADMIN_TI
}

enum Categoria {
  ALHOS
  PIMENTAS
  CHAS
  ERVAS
  ESPECIARIAS
  SAIS
  OUTROS
}

enum StatusPedido {
  RASCUNHO
  CONFIRMADO
  CANCELADO
}

model Local {
  id          String   @id @default(uuid())
  codigo      String   @unique
  nome        String
  endereco    String?
  telefone    String?
  responsavel String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  usuarios   User[]
  vendedores Vendedor[]
  clientes   Cliente[]
  pedidos    Pedido[]

  @@map("locais")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  type         UserType
  localId      String?   @map("local_id")
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  ultimoAcesso DateTime? @map("ultimo_acesso")

  local            Local?    @relation(fields: [localId], references: [id])
  vendedor         Vendedor?
  pedidosEditados  Pedido[]  @relation("PedidoEditadoPor")
  pedidosAlterados Pedido[]  @relation("PedidoUltimaAlteracao")

  @@map("usuarios")
}

model Vendedor {
  id                 String  @id @default(uuid())
  usuarioId          String  @unique @map("usuario_id")
  nomeCompleto       String  @map("nome_completo")
  telefone           String?
  comissaoPercentual Float?  @map("comissao_percentual")
  localId            String  @map("local_id")
  ativo              Boolean @default(true)

  usuario  User              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  local    Local             @relation(fields: [localId], references: [id])
  pedidos  Pedido[]
  clientes ClienteVendedor[]

  @@map("vendedores")
}

// Suporta o logout com JWT (invalidação de token, Seção 5.1 do planejamento).
model TokenRevogado {
  jti        String   @id
  usuarioId  String   @map("usuario_id")
  revogadoEm DateTime @default(now()) @map("revogado_em")
  expiraEm   DateTime @map("expira_em")

  @@map("tokens_revogados")
}

model Cliente {
  id                String   @id @default(uuid())
  codigo            String   @unique
  nome              String
  nomeFantasia      String?  @map("nome_fantasia")
  cnpj              String?
  email             String?
  telefone          String?
  // Endereco em campos separados: o CEP preenche logradouro/bairro/cidade/UF
  // automaticamente na tela, e numero/complemento sao digitados pelo usuario.
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  // Contato de quem faz a compra (pode ser diferente do telefone da empresa).
  nomeComprador     String?  @map("nome_comprador")
  telefoneComprador String?  @map("telefone_comprador")
  localId           String   @map("local_id")
  // Tabela de preco do cliente. Opcional: sem tabela, vale o preco do catalogo.
  tabelaPrecoId     String?  @map("tabela_preco_id")
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  local           Local             @relation(fields: [localId], references: [id])
  tabelaPreco     TabelaPreco?      @relation(fields: [tabelaPrecoId], references: [id])
  clienteProdutos ClienteProduto[]
  vendedores      ClienteVendedor[]
  pedidos         Pedido[]

  @@map("clientes")
}

model Produto {
  id            String    @id @default(uuid())
  codigo        String    @unique
  nome          String
  categoria     Categoria
  descricao     String?
  preco         Decimal   @db.Decimal(10, 2)
  unidadeMedida String    @map("unidade_medida")
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  clienteProdutos  ClienteProduto[]
  tabelaPrecoItens TabelaPrecoItem[]
  itensPedido      ItemPedido[]

  @@map("produtos")
}

// "Mix do cliente" (RN-10): quais produtos cada cliente compra. Gerenciado pelo admin.
model ClienteProduto {
  id          String   @id @default(uuid())
  clienteId   String   @map("cliente_id")
  produtoId   String   @map("produto_id")
  ativo       Boolean  @default(true)
  associadoEm DateTime @default(now()) @map("associado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, produtoId])
  @@map("clientes_produtos")
}

// Tabela de preco: um mesmo produto pode ter valores diferentes por grupo de
// clientes (atacado, rede X, padrao...). Cada cliente pertence a uma tabela.
model TabelaPreco {
  id           String   @id @default(uuid())
  nome         String   @unique
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  itens    TabelaPrecoItem[]
  clientes Cliente[]

  @@map("tabelas_preco")
}

// Preco de um produto dentro de uma tabela. Sem linha aqui, vale Produto.preco.
model TabelaPrecoItem {
  id        String  @id @default(uuid())
  tabelaId  String  @map("tabela_id")
  produtoId String  @map("produto_id")
  preco     Decimal @db.Decimal(10, 2)

  tabela  TabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  produto Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([tabelaId, produtoId])
  @@map("tabelas_preco_itens")
}

// Carteira: quais vendedores atendem o cliente. Vendedor so ve os seus.
model ClienteVendedor {
  id          String   @id @default(uuid())
  clienteId   String   @map("cliente_id")
  vendedorId  String   @map("vendedor_id")
  associadoEm DateTime @default(now()) @map("associado_em")

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@unique([clienteId, vendedorId])
  @@map("clientes_vendedores")
}

model Pedido {
  id                   String       @id @default(uuid())
  numeroPedido         String?      @unique @map("numero_pedido")
  vendedorId           String       @map("vendedor_id")
  clienteId            String       @map("cliente_id")
  localId              String       @map("local_id")
  dataPedido           DateTime     @default(now()) @map("data_pedido") @db.Date
  status               StatusPedido @default(RASCUNHO)
  observacoes          String?
  subtotal             Decimal      @default(0) @db.Decimal(10, 2)
  total                Decimal      @default(0) @db.Decimal(10, 2)
  criadoEm             DateTime     @default(now()) @map("criado_em")
  confirmadoEm         DateTime?    @map("confirmado_em")
  canceladoEm          DateTime?    @map("cancelado_em")
  motivoCancelamento   String?      @map("motivo_cancelamento")
  editadoPorId         String?      @map("editado_por_id")
  editadoEm            DateTime?    @map("editado_em")
  // Última alteração por qualquer perfil (vendedor ou comercial) após o envio.
  // Separado de editadoPor (que é o marcador de revisão do comercial / "Novo").
  ultimaAlteracaoPorId String?      @map("ultima_alteracao_por_id")
  ultimaAlteracaoEm    DateTime?    @map("ultima_alteracao_em")

  vendedor           Vendedor     @relation(fields: [vendedorId], references: [id])
  cliente            Cliente      @relation(fields: [clienteId], references: [id])
  local              Local        @relation(fields: [localId], references: [id])
  itens              ItemPedido[]
  editadoPor         User?        @relation("PedidoEditadoPor", fields: [editadoPorId], references: [id])
  ultimaAlteracaoPor User?        @relation("PedidoUltimaAlteracao", fields: [ultimaAlteracaoPorId], references: [id])

  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String  @map("pedido_id")
  produtoId     String  @map("produto_id")
  quantidade    Decimal @db.Decimal(10, 3)
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}
